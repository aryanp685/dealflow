# Local dev needs none of these. Production (Vercel) needs AUTH_SECRET + DATABASE_URL at minimum.

# Session JWT signing. Required in production. Generate: openssl rand -base64 32
AUTH_SECRET=

# Supabase "Transaction pooler" connection string + ?sslmode=require. Without it, local SQLite is used.
DATABASE_URL=

# Canonical site URL, used for reset links, sitemap and checkout redirects.
NEXT_PUBLIC_SITE_URL=https://dealflow.vercel.app

# Sliding-window rate limits shared across serverless instances. Without these, in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay (INR plans). Without these, checkout links are placeholders and the UI says so.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Without this, /api/webhooks/razorpay returns 503 and no plan is ever granted.
RAZORPAY_WEBHOOK_SECRET=

# Stripe (USD plans). Without these, the Stripe rail is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (daily digest + password-reset emails). Without these, digest is dry-run and reset returns 503 in production.
RESEND_API_KEY=
RESEND_FROM=

# Bearer token Vercel Cron sends on /api/cron/digest runs. Without it the endpoint answers 401 to everyone.
CRON_SECRET=

# Optional. Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=

# Optional. Overrides the local SQLite file location (default: data/dealflow.db).
DEALFLOW_DB_PATH=

# Payhip license keys (for buyers who purchased on Payhip). Both from the Payhip
# product page (enable "license keys" first): the product secret key and the
# product link shown on the same page. Without these, /api/license/redeem returns 503.
PAYHIP_PRODUCT_SECRET=
PAYHIP_PRODUCT_LINK=
